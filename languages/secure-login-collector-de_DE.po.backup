msgstr "Unbekannter Fehler"

#: includes/class-admin-interface.php:679
msgid "networkError"
msgstr "Netzwerkfehler"

#: includes/class-admin-interface.php:680
msgid "saveEntry"
msgstr "Eintrag speichern"

#: includes/class-admin-interface.php:681
msgid "bulkDecryptWithPasskey"
msgstr "Massenentschlüsselung mit Passkey"

#: includes/class-admin-interface.php:682
msgid "authenticateWithPasskeyToDecryptAll"
msgstr "Mit Passkey authentifizieren, um alle zu entschlüsseln"

#: includes/class-admin-interface.php:683
msgid "bulkDecryptionCompleted"
msgstr "Massenentschlüsselung abgeschlossen"

#: includes/class-admin-interface.php:729
msgid "Add New Entry"
msgstr "Neuen Eintrag hinzufügen"

#: includes/class-admin-interface.php:730
msgid "This page shows all encrypted login data collected from clients. Use the search box to filter entries and bulk actions for management."
msgstr "Diese Seite zeigt alle verschlüsselten Login-Daten, die von Kunden gesammelt wurden. Verwenden Sie das Suchfeld zum Filtern von Einträgen und Massenaktionen zur Verwaltung."

#: includes/class-admin-interface.php:733
msgid "Search entries"
msgstr "Einträge suchen"

#: includes/class-admin-interface.php:737
msgid "Add New Login Data Entry"
msgstr "Neuen Login-Dateneintrag hinzufügen"

#: includes/class-admin-interface.php:744
msgid "Login URL or service name where these credentials are used."
msgstr "Login-URL oder Dienstname, wo diese Anmeldedaten verwendet werden."

#: includes/class-admin-interface.php:748
msgid "Username/Email"
msgstr "Benutzername/E-Mail"

#: includes/class-admin-interface.php:751
msgid "The username or email address used to log into this service."
msgstr "Der Benutzername oder die E-Mail-Adresse, die für die Anmeldung bei diesem Dienst verwendet wird."

#: includes/class-admin-interface.php:755
msgid "Password"
msgstr "Passwort"

#: includes/class-admin-interface.php:758
msgid "The password for this account."
msgstr "Das Passwort für dieses Konto."

#: includes/class-admin-interface.php:762
msgid "Additional Notes"
msgstr "Zusätzliche Notizen"

#: includes/class-admin-interface.php:769
msgid "Encryption Method"
msgstr "Verschlüsselungsmethode"

#: includes/class-admin-interface.php:775
msgid "🔐 Ultra-Secure (Passkey)"
msgstr "🔐 Ultra-Sicher (Passkey)"

#: includes/class-admin-interface.php:777
msgid "🔒 RSA-2048"
msgstr "🔒 RSA-2048"

#: includes/class-admin-interface.php:779
msgid "Choose the encryption method for this entry."
msgstr "Wählen Sie die Verschlüsselungsmethode für diesen Eintrag."

#: includes/class-admin-interface.php:786
msgid "Save Entry"
msgstr "Eintrag speichern"

#: includes/class-admin-interface.php:789
msgid "Cancel"
msgstr "Abbrechen"

#: includes/class-admin-interface.php:822
msgid "Entries per page"
msgstr "Einträge pro Seite"

#: includes/class-admin-interface.php:848
#: includes/class-admin-interface.php:970
#: includes/class-admin-interface.php:1140
#: includes/class-admin-interface.php:1187
#: includes/class-admin-interface.php:1302
#: includes/class-admin-interface.php:1334
#: includes/class-encryption-handler.php:78
#: includes/class-encryption-handler.php:126
#: includes/class-encryption-handler.php:488
msgid "Invalid security token or insufficient permissions."
msgstr "Ungültiges Sicherheitstoken oder unzureichende Berechtigungen."

#: includes/class-admin-interface.php:853
msgid "Insufficient permissions."
msgstr "Unzureichende Berechtigungen."

#: includes/class-admin-interface.php:862
msgid "Export request not found or expired."
msgstr "Exportanfrage nicht gefunden oder abgelaufen."

#: includes/class-admin-interface.php:878
#, php-format
msgid "Bulk export prepared for %d entries."
msgstr "Massenexport für %d Einträge vorbereitet."

#: includes/class-admin-interface.php:894
#: includes/class-admin-interface.php:936
#: includes/class-admin-interface.php:1124
#: includes/class-admin-interface.php:1233
#: includes/class-admin-interface.php:1270
#: includes/class-admin-interface.php:1471
#: includes/class-encryption-handler.php:548
msgid "Invalid security token."
msgstr "Ungültiges Sicherheitstoken."

#: includes/class-admin-interface.php:905
#: includes/class-admin-interface.php:994
#: includes/class-encryption-handler.php:168
#: includes/class-encryption-handler.php:309
#: includes/class-encryption-handler.php:372
#: includes/class-encryption-handler.php:452
msgid "Pro version required."
msgstr "Pro-Version erforderlich."

#: includes/class-admin-interface.php:910
#: includes/class-admin-interface.php:1001
#: includes/class-encryption-handler.php:173
#: includes/class-encryption-handler.php:314
#: includes/class-encryption-handler.php:414
#: includes/class-encryption-handler.php:462
msgid "Passkey not registered."
msgstr "Passkey nicht registriert."

#: includes/class-admin-interface.php:915
msgid "Missing export manager."
msgstr "Export-Manager fehlt."

#: includes/class-admin-interface.php:923
msgid "No entries selected for export."
msgstr "Keine Einträge für Export ausgewählt."

#: includes/class-admin-interface.php:940
#, php-format
msgid "You have selected %1$d entries for bulk export. All selected entries will be decrypted using your passkey and then exported to %2$s format."
msgstr "Sie haben %1$d Einträge für den Massenexport ausgewählt. Alle ausgewählten Einträge werden mit Ihrem Passkey entschlüsselt und dann in das %2$s-Format exportiert."

#: includes/class-admin-interface.php:990
msgid "Missing passkey signature."
msgstr "Passkey-Signatur fehlt."

#: includes/class-admin-interface.php:1020
msgid "Bulk decrypt request not found or expired."
msgstr "Massenentschlüsselungsanfrage nicht gefunden oder abgelaufen."

#: includes/class-admin-interface.php:1043
#, php-format
msgid "Successfully decrypted %d entries. Generating CSV..."
msgstr "Erfolgreich %d Einträge entschlüsselt. CSV wird generiert..."

#: includes/class-admin-interface.php:1046
msgid "Bulk decryption failed for some entries. Only successfully decrypted entries were exported."
msgstr "Massenentschlüsselung für einige Einträge fehlgeschlagen. Nur erfolgreich entschlüsselte Einträge wurden exportiert."

#: includes/class-admin-interface.php:1049
msgid "Bulk decryption failed for all entries."
msgstr "Massenentschlüsselung für alle Einträge fehlgeschlagen."

#: includes/class-admin-interface.php:1143
msgid "Passkey authentication is required in Pro version. Traditional decryption is disabled for enhanced security."
msgstr "Passkey-Authentifizierung ist in der Pro-Version erforderlich. Traditionelle Entschlüsselung ist für erhöhte Sicherheit deaktiviert."

#: includes/class-admin-interface.php:1151
msgid "Passkey authentication required. Please authenticate with your passkey."
msgstr "Passkey-Authentifizierung erforderlich. Bitte authentifizieren Sie sich mit Ihrem Passkey."

#: includes/class-admin-interface.php:1160
msgid "Data not found."
msgstr "Daten nicht gefunden."

#: includes/class-admin-interface.php:1174
msgid "Passkey decryption failed. Please check your passkey authentication."
msgstr "Passkey-Entschlüsselung fehlgeschlagen. Bitte überprüfen Sie Ihre Passkey-Authentifizierung."

#: includes/class-admin-interface.php:1201
msgid "Passkey not registered. Please register a passkey first or use traditional decryption."
msgstr "Passkey nicht registriert. Bitte registrieren Sie zuerst einen Passkey oder verwenden Sie die traditionelle Entschlüsselung."

#: includes/class-admin-interface.php:1220
msgid "Missing encryption key."
msgstr "Verschlüsselungsschlüssel fehlt."

#: includes/class-admin-interface.php:1226
msgid "Decryption failed. Please check the encryption key."
msgstr "Entschlüsselung fehlgeschlagen. Bitte überprüfen Sie den Verschlüsselungsschlüssel."

#: includes/class-admin-interface.php:1242
msgid "Failed to delete data."
msgstr "Daten konnten nicht gelöscht werden."

#: includes/class-admin-interface.php:1246
msgid "Data deleted successfully."
msgstr "Daten erfolgreich gelöscht."

#: includes/class-admin-interface.php:1280
msgid "Failed to extend retention."
msgstr "Aufbewahrung konnte nicht verlängert werden."

#: includes/class-admin-interface.php:1287
#, php-format
msgid "Retention period extended by %d days."
msgstr "Aufbewahrungszeitraum um %d Tage verlängert."

#: includes/class-admin-interface.php:1307
msgid "Invalid metadata format."
msgstr "Ungültiges Metadatenformat."

#: includes/class-admin-interface.php:1312
msgid "Missing required metadata fields."
msgstr "Erforderliche Metadatenfelder fehlen."

