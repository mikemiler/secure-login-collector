#: includes/class-database-manager.php:385
#: includes/class-admin-interface.php:636
msgid "Not provided"
msgstr "Nicht angegeben"

#: includes/class-admin-interface.php:310
msgid "🔐 Ultra-Secure (Passkey)"
msgstr "🔐 Ultra-Sicher (Passkey)"

#: includes/class-admin-interface.php:312
msgid "Passkey-derived encryption for maximum security."
msgstr "Passkey-abgeleitete Verschlüsselung für maximale Sicherheit."

#: includes/class-admin-interface.php:316
msgid "🔒 RSA-2048"
msgstr "🔒 RSA-2048"

#: includes/class-admin-interface.php:318
msgid "Industry-standard RSA encryption."
msgstr "Industriestandard RSA-Verschlüsselung."

#: includes/class-admin-interface.php:444
msgid "Edit entry"
msgstr "Eintrag bearbeiten"

#: includes/class-admin-interface.php:445
msgid "Save changes"
msgstr "Änderungen speichern"

#: includes/class-admin-interface.php:446
msgid "Cancel editing"
msgstr "Bearbeitung abbrechen"

