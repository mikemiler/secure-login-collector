msgid "%d entry deleted."
msgid_plural "%d entries deleted."
msgstr[0] "%d Eintrag gelöscht."
msgstr[1] "%d Einträge gelöscht."

#: includes/class-admin-interface.php:539
#, php-format
msgid "Bulk export initiated for %d entries. Please wait..."
msgstr "Massenexport für %d Einträge gestartet. Bitte warten..."

#: includes/class-admin-interface.php:547
msgid "Search in email, name, login URL..."
msgstr "In E-Mail, Name, Login-URL suchen..."

#: includes/class-admin-interface.php:570
msgid "Decrypted Data:"
msgstr "Entschlüsselte Daten:"

#: includes/class-admin-interface.php:589
msgid "Export to Password Manager"
msgstr "In Passwort-Manager exportieren"

#: includes/class-admin-interface.php:590
msgid "Hide"
msgstr "Ausblenden"

#: includes/class-admin-interface.php:601
msgid "Login Data"
msgstr "Login-Daten"

#: includes/class-admin-interface.php:603
msgid "Secure Login Data"
msgstr "Sichere Login-Daten"

#: includes/class-admin-interface.php:637
msgid "Saving..."
msgstr "Speichern..."

#: includes/class-admin-interface.php:638
msgid "Save failed: "
msgstr "Speichern fehlgeschlagen: "

#: includes/class-admin-interface.php:640
msgid "Network error occurred during save."
msgstr "Netzwerkfehler beim Speichern aufgetreten."

#: includes/class-admin-interface.php:641
msgid "Requesting passkey..."
msgstr "Passkey anfordern..."

#: includes/class-admin-interface.php:642
msgid "Passkey authentication setup failed: "
msgstr "Passkey-Authentifizierung fehlgeschlagen: "

#: includes/class-admin-interface.php:644
msgid "Network error occurred during passkey setup."
msgstr "Netzwerkfehler bei der Passkey-Einrichtung aufgetreten."

#: includes/class-admin-interface.php:645
msgid "Pro version detected but no passkey registered. Continue with traditional decryption?"
msgstr "Pro-Version erkannt, aber kein Passkey registriert. Mit traditioneller Entschlüsselung fortfahren?"

#: includes/class-admin-interface.php:646
msgid "This entry was created before automatic key reconstruction was available. Please enter the encryption key manually:"
msgstr "Dieser Eintrag wurde erstellt, bevor die automatische Schlüssel-Rekonstruktion verfügbar war. Bitte geben Sie den Verschlüsselungsschlüssel manuell ein:"

#: includes/class-admin-interface.php:647
msgid "Decrypting..."
msgstr "Entschlüsseln..."

#: includes/class-admin-interface.php:648
msgid "Data decrypted"
msgstr "Daten entschlüsselt"

#: includes/class-admin-interface.php:649
msgid "Decryption failed: "
msgstr "Entschlüsselung fehlgeschlagen: "

#: includes/class-admin-interface.php:650
msgid "Network error occurred during decryption."
msgstr "Netzwerkfehler bei der Entschlüsselung aufgetreten."

#: includes/class-admin-interface.php:651
msgid "Error processing decryption: "
msgstr "Fehler bei der Verarbeitung der Entschlüsselung: "

#: includes/class-admin-interface.php:652
msgid "Authenticate with passkey..."
msgstr "Mit Passkey authentifizieren..."

#: includes/class-admin-interface.php:653
msgid "WebAuthn/Passkeys are not supported in this browser."
msgstr "WebAuthn/Passkeys werden in diesem Browser nicht unterstützt."

#: includes/class-admin-interface.php:654
msgid "Verifying passkey and decrypting..."
msgstr "Passkey verifizieren und entschlüsseln..."

#: includes/class-admin-interface.php:655
msgid "Data decrypted with passkey"
msgstr "Daten mit Passkey entschlüsselt"

#: includes/class-admin-interface.php:656
msgid "Passkey decryption failed: "
msgstr "Passkey-Entschlüsselung fehlgeschlagen: "

#: includes/class-admin-interface.php:657
msgid "Network error occurred during passkey decryption."
msgstr "Netzwerkfehler bei der Passkey-Entschlüsselung aufgetreten."

#: includes/class-admin-interface.php:658
msgid "Passkey authentication failed:"
msgstr "Passkey-Authentifizierung fehlgeschlagen:"

#: includes/class-admin-interface.php:659
msgid "Are you sure you want to extend the retention period for this entry?"
msgstr "Sind Sie sicher, dass Sie den Aufbewahrungszeitraum für diesen Eintrag verlängern möchten?"

#: includes/class-admin-interface.php:660
msgid "Extending..."
msgstr "Verlängern..."

#: includes/class-admin-interface.php:661
msgid "Retention period extended successfully."
msgstr "Aufbewahrungszeitraum erfolgreich verlängert."

