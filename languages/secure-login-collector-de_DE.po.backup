#: includes/class-frontend-handler.php:109
msgid "Please fill in all required fields (Email Address, Name, Login URL, Username/Email, and Password)."
msgstr "Bitte füllen Sie alle Pflichtfelder aus (E-Mail-Adresse, Name, Login-URL, Benutzername/E-Mail und Passwort)."

#: includes/class-frontend-handler.php:110
msgid "Submitting..."
msgstr "Sende..."

#: includes/class-frontend-handler.php:111
#: includes/class-frontend-handler.php:241
msgid "Submit Securely"
msgstr "Sicher absenden"

#: includes/class-frontend-handler.php:112
msgid "Login data saved securely! Thank you for your submission."
msgstr "Login-Daten wurden sicher gespeichert! Vielen Dank für Ihre Übermittlung."

#: includes/class-frontend-handler.php:113
msgid "Error saving data: "
msgstr "Fehler beim Speichern der Daten: "

#: includes/class-frontend-handler.php:114
#: includes/class-admin-interface.php:639
msgid "Unknown error"
msgstr "Unbekannter Fehler"

#: includes/class-frontend-handler.php:115
msgid "Network error occurred while saving data. Please try again."
msgstr "Netzwerkfehler beim Speichern der Daten. Bitte versuchen Sie es erneut."

#: includes/class-frontend-handler.php:116
msgid "Encryption failed. Please try again."
msgstr "Verschlüsselung fehlgeschlagen. Bitte versuchen Sie es erneut."

#: includes/class-frontend-handler.php:117
msgid "Show password"
msgstr "Passwort anzeigen"

#: includes/class-frontend-handler.php:118
msgid "Hide password"
msgstr "Passwort verbergen"

#: includes/class-frontend-handler.php:119
msgid "Encryption failed"
msgstr "Verschlüsselung fehlgeschlagen"

#: includes/class-frontend-handler.php:120
msgid "No encryption method available"
msgstr "Keine Verschlüsselungsmethode verfügbar"

#: includes/class-frontend-handler.php:121
msgid "RSA public key not available. Please contact administrator."
msgstr "RSA-öffentlicher Schlüssel nicht verfügbar. Bitte kontaktieren Sie den Administrator."

#: includes/class-frontend-handler.php:122
msgid "Encryption failed. Please try again or contact administrator."
msgstr "Verschlüsselung fehlgeschlagen. Bitte versuchen Sie es erneut oder kontaktieren Sie den Administrator."

#: includes/class-frontend-handler.php:141
msgid "Invalid security token."
msgstr "Ungültiges Sicherheitstoken."

#: includes/class-frontend-handler.php:150
msgid "Missing required data."
msgstr "Erforderliche Daten fehlen."

#: includes/class-frontend-handler.php:157
msgid "Invalid metadata format. JSON Error: "
msgstr "Ungültiges Metadatenformat. JSON-Fehler: "

#: includes/class-frontend-handler.php:165
#: includes/class-frontend-handler.php:171
#: includes/class-frontend-handler.php:177
#: includes/class-frontend-handler.php:183
#, php-format
msgid "Missing %s in metadata."
msgstr "%s fehlt in den Metadaten."

#: includes/class-frontend-handler.php:221
msgid "Failed to save data to database."
msgstr "Daten konnten nicht in der Datenbank gespeichert werden."

#: includes/class-frontend-handler.php:228
msgid "Login data saved securely."
msgstr "Login-Daten wurden sicher gespeichert."

#: includes/class-frontend-handler.php:240
msgid "Submit Secure Login Data"
msgstr "Sichere Login-Daten übermitteln"

#: includes/class-frontend-handler.php:261
#, php-format
msgid "for %d days, after which it will be automatically deleted"
msgstr "für %d Tage, danach werden sie automatisch gelöscht"

#: includes/class-frontend-handler.php:263
#: includes/class-frontend-handler.php:296
msgid "Auto-deletion is disabled, so data will be retained until manually deleted by the administrator."
msgstr "Die automatische Löschung ist deaktiviert, daher werden die Daten gespeichert, bis sie vom Administrator manuell gelöscht werden."

#: includes/class-frontend-handler.php:287
msgid "What happens to your data:"
msgstr "Was mit Ihren Daten geschieht:"

#: includes/class-frontend-handler.php:287
msgid "Your login data is encrypted in your browser before being sent to our server. We use strong RSA-2048 encryption to ensure maximum security."
msgstr "Ihre Login-Daten werden in Ihrem Browser verschlüsselt, bevor sie an unseren Server gesendet werden. Wir verwenden starke RSA-2048-Verschlüsselung für maximale Sicherheit."

#: includes/class-frontend-handler.php:289
#: includes/class-frontend-handler.php:296
msgid "Security & Privacy:"
msgstr "Sicherheit & Datenschutz:"

#: includes/class-frontend-handler.php:292
#, php-format
msgid "Your data is encrypted in your browser before being sent to our server. We store the encrypted data securely for %d days, after which it will be automatically deleted."
msgstr "Ihre Daten werden in Ihrem Browser verschlüsselt, bevor sie an unseren Server gesendet werden. Wir speichern die verschlüsselten Daten sicher für %d Tage, danach werden sie automatisch gelöscht."

#: includes/class-frontend-handler.php:296
msgid "Your data is encrypted in your browser before being sent to our server. We store the encrypted data securely. Auto-deletion is disabled, so data will be retained until manually deleted by the administrator."
msgstr "Ihre Daten werden in Ihrem Browser verschlüsselt, bevor sie an unseren Server gesendet werden. Wir speichern die verschlüsselten Daten sicher. Die automatische Löschung ist deaktiviert, daher werden die Daten gespeichert, bis sie vom Administrator manuell gelöscht werden."

#: includes/class-frontend-handler.php:302
msgid "Email Address:"
msgstr "E-Mail-Adresse:"

#: includes/class-frontend-handler.php:303
msgid "your@email.com"
msgstr "ihre@email.de"

#: includes/class-frontend-handler.php:307
msgid "Name:"
msgstr "Name:"

#: includes/class-frontend-handler.php:308
msgid "Your full name"
msgstr "Ihr vollständiger Name"

#: includes/class-frontend-handler.php:312
msgid "Login URL:"
msgstr "Login-URL:"

#: includes/class-frontend-handler.php:313
msgid "https://example.com/login or service name"
msgstr "https://beispiel.de/login oder Dienstname"

#: includes/class-frontend-handler.php:314
#: includes/class-admin-interface.php:744
msgid "Enter the login URL or service name where these credentials are used."
msgstr "Geben Sie die Login-URL oder den Dienstnamen ein, wo diese Anmeldedaten verwendet werden."

#: includes/class-frontend-handler.php:318
msgid "Username/Email:"
msgstr "Benutzername/E-Mail:"

#: includes/class-frontend-handler.php:319
msgid "Username or email for login"
msgstr "Benutzername oder E-Mail für Login"

#: includes/class-frontend-handler.php:320
#: includes/class-admin-interface.php:751
msgid "The username or email address used to log into this service."
msgstr "Der Benutzername oder die E-Mail-Adresse, die für die Anmeldung bei diesem Dienst verwendet wird."

#: includes/class-frontend-handler.php:324
msgid "Password:"
msgstr "Passwort:"

#: includes/class-frontend-handler.php:326
msgid "Enter the password"
msgstr "Passwort eingeben"

#: includes/class-frontend-handler.php:327
msgid "Toggle password visibility"
msgstr "Passwort-Sichtbarkeit umschalten"

#: includes/class-frontend-handler.php:331
#: includes/class-admin-interface.php:758
msgid "The password for this account."
msgstr "Das Passwort für dieses Konto."

#: includes/class-frontend-handler.php:335
msgid "Additional Notes:"
msgstr "Zusätzliche Notizen:"

#: includes/class-frontend-handler.php:336
#: includes/class-admin-interface.php:763
msgid "Any additional information, security questions, backup codes, etc. (optional)"
msgstr "Zusätzliche Informationen, Sicherheitsfragen, Backup-Codes usw. (optional)"

#: includes/class-frontend-handler.php:337
#: includes/class-admin-interface.php:765
msgid "Optional: Any additional information like security questions, backup codes, or special instructions."
msgstr "Optional: Zusätzliche Informationen wie Sicherheitsfragen, Backup-Codes oder spezielle Anweisungen."

#: includes/class-admin-interface.php:89
msgid "Email Address"
msgstr "E-Mail-Adresse"

