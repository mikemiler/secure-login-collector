# Frontend form strings
msgid "Submit Secure Login Data"
msgstr "Sichere Anmeldedaten übermitteln"

msgid "Submit Securely"
msgstr "Sicher übermitteln"

msgid "Please fill out this form to securely send your login credentials. All data is encrypted before transmission."
msgstr "Bitte füllen Sie dieses Formular aus, um Ihre Anmeldedaten sicher zu senden. Alle Daten werden vor der Übertragung verschlüsselt."

msgid "Security & Privacy:"
msgstr "Sicherheit & Datenschutz:"

msgid "Your data is encrypted in your browser before being sent to our server. We store the encrypted data securely and automatically delete it after %d days for your privacy and security."
msgstr "Ihre Daten werden in Ihrem Browser verschlüsselt, bevor sie an unseren Server gesendet werden. Wir speichern die verschlüsselten Daten sicher und löschen sie automatisch nach %d Tagen für Ihren Datenschutz und Ihre Sicherheit."

msgid "Your data is encrypted in your browser before being sent to our server. We store the encrypted data securely for your privacy and security."
msgstr "Ihre Daten werden in Ihrem Browser verschlüsselt, bevor sie an unseren Server gesendet werden. Wir speichern die verschlüsselten Daten sicher für Ihren Datenschutz und Ihre Sicherheit."

msgid "Email Address:"
msgstr "E-Mail-Adresse:"

msgid "your@email.com"
msgstr "ihre@email.de"

msgid "Name:"
msgstr "Name:"

msgid "Your full name"
msgstr "Ihr vollständiger Name"

msgid "Service Name:"
msgstr "Service-Name:"

msgid "Name like email account or hosting company etc."
msgstr "Name wie E-Mail-Konto oder Hosting-Unternehmen usw."

msgid "Enter the name of the service, email provider, hosting company, or platform these credentials are for."
msgstr "Geben Sie den Namen des Dienstes, E-Mail-Anbieters, Hosting-Unternehmens oder der Plattform ein, für die diese Anmeldedaten bestimmt sind."

msgid "Login Data:"
msgstr "Anmeldedaten:"

msgid "Enter your login credentials, passwords, or any access information here..."
msgstr "Geben Sie hier Ihre Anmeldedaten, Passwörter oder andere Zugriffsinformationen ein..."

msgid "Enter usernames, passwords, URLs, or any login information you need to share securely."
msgstr "Geben Sie Benutzernamen, Passwörter, URLs oder andere Anmeldeinformationen ein, die Sie sicher teilen möchten."

