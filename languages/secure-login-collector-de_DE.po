# Passkey authentication strings
msgid "Passkey not registered. Please register a passkey first."
msgstr "Passkey nicht registriert. Bitte registrieren Sie zuerst einen Passkey."

msgid "Passkey authentication required. Please authenticate with your passkey."
msgstr "Passkey-Authentifizierung erforderlich. Bitte authentifizieren Sie sich mit Ihrem Passkey."

msgid "Missing encryption key."
msgstr "Verschlüsselungsschlüssel fehlt."

msgid "Pro version required."
msgstr "Pro-Version erforderlich."

msgid "Missing credential data."
msgstr "Anmeldedaten fehlen."

msgid "Passkey registered successfully."
msgstr "Passkey erfolgreich registriert."

msgid "Passkey not registered."
msgstr "Passkey nicht registriert."

msgid "No pending decrypt request found."
msgstr "Keine ausstehende Entschlüsselungsanfrage gefunden."

