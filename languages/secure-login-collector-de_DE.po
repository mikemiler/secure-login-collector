msgid "[%s] New Secure Login Data Received"
msgstr "[%s] Neue sichere Anmeldedaten erhalten"

msgid "Hello,\n\nNew secure login data has been submitted to your website.\n\nSender Email: %s\nSender Name: %s\nSubmitted: %s\n\nTo view and decrypt the login data, please visit:\n%s\n\nThis is an automated notification from %s\nWebsite: %s"
msgstr "Hallo,\n\nNeue sichere Anmeldedaten wurden an Ihre Website übermittelt.\n\nAbsender E-Mail: %s\nAbsender Name: %s\nÜbermittelt: %s\n\nUm die Anmeldedaten anzuzeigen und zu entschlüsseln, besuchen Sie bitte:\n%s\n\nDies ist eine automatische Benachrichtigung von %s\nWebsite: %s"

msgid "Not provided"
msgstr "Nicht angegeben"

msgid "Never expires"
msgstr "Läuft nie ab"

msgid "Expired"
msgstr "Abgelaufen"

